---
/**
 * The pop-up definition card for highlighted glossary terms.
 * Included once in BaseLayout. Tapping any .gloss-term opens it.
 *
 * Saved progress (this browser only), under `bible:terms`:
 *   { [slug]: { status: 'seen' | 'learning' | 'known', firstSeen, updated } }
 */
import { getGlossaryCardData } from '../lib/glossary';
const data = await getGlossaryCardData();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div id="gloss-card" class="gloss-card hidden" role="dialog" aria-modal="false" aria-labelledby="gloss-card-term" data-base={base}>
  <div class="flex items-start justify-between gap-3">
    <div>
      <div id="gloss-card-cat" class="text-[11px] uppercase tracking-wider text-amber-700 font-semibold"></div>
      <div id="gloss-card-term" class="text-lg font-bold text-slate-900 leading-snug"></div>
    </div>
    <button type="button" class="gloss-close -mt-1 -mr-1 p-2 text-slate-400 hover:text-slate-700 text-xl leading-none" aria-label="Close">&times;</button>
  </div>
  <p id="gloss-card-short" class="mt-2 text-slate-700 leading-relaxed"></p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <button type="button" class="gloss-status px-3 py-1.5 rounded-full border text-sm font-medium" data-status="known">✓ I know this</button>
    <button type="button" class="gloss-status px-3 py-1.5 rounded-full border text-sm font-medium" data-status="learning">Still learning</button>
    <a id="gloss-card-more" class="ml-auto text-sm font-semibold text-amber-700 hover:text-amber-900 py-1.5" href="#">Learn more →</a>
  </div>
</div>
<script id="gloss-data" type="application/json" set:html={JSON.stringify(data)}></script>

<script>
  const KEY = 'bible:terms';
  type Rec = { status: 'seen' | 'learning' | 'known'; firstSeen: string; updated: string };

  function load(): Record<string, Rec> {
    try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
  }
  function save(all: Record<string, Rec>) {
    try { localStorage.setItem(KEY, JSON.stringify(all)); } catch {}
    window.dispatchEvent(new CustomEvent('bible:terms-updated'));
  }
  function setStatus(slug: string, status: Rec['status'], onlyIfNew = false) {
    const all = load();
    const now = new Date().toISOString();
    if (onlyIfNew && all[slug]) return;
    all[slug] = { status, firstSeen: all[slug]?.firstSeen ?? now, updated: now };
    save(all);
  }

  const card = document.getElementById('gloss-card') as HTMLElement;
  const data: Record<string, { term: string; short: string; category?: string }> =
    JSON.parse(document.getElementById('gloss-data')?.textContent || '{}');
  const base = card.dataset.base || '';
  let openSlug: string | null = null;
  let openTrigger: HTMLElement | null = null;

  function paintTerms() {
    const all = load();
    document.querySelectorAll<HTMLElement>('.gloss-term').forEach((el) => {
      const s = all[el.dataset.gloss || '']?.status;
      el.dataset.status = s || 'new';
    });
  }

  function paintButtons() {
    if (!openSlug) return;
    const s = load()[openSlug]?.status;
    card.querySelectorAll<HTMLElement>('.gloss-status').forEach((b) => {
      const on = b.dataset.status === s;
      b.setAttribute('aria-pressed', String(on));
      b.className = 'gloss-status px-3 py-1.5 rounded-full border text-sm font-medium ' +
        (on ? (s === 'known' ? 'bg-green-600 border-green-600 text-white' : 'bg-amber-500 border-amber-500 text-white')
            : 'bg-white border-slate-300 text-slate-700 hover:border-slate-500');
    });
  }

  function position(trigger: HTMLElement) {
    if (window.innerWidth < 640) {
      card.style.left = ''; card.style.top = '';
      card.classList.add('gloss-card--sheet');
      return;
    }
    card.classList.remove('gloss-card--sheet');
    const r = trigger.getBoundingClientRect();
    const width = Math.min(360, window.innerWidth - 24);
    let left = r.left + window.scrollX;
    left = Math.max(12, Math.min(left, window.scrollX + window.innerWidth - width - 12));
    card.style.width = width + 'px';
    card.style.left = left + 'px';
    card.style.top = r.bottom + window.scrollY + 8 + 'px';
  }

  function open(trigger: HTMLElement) {
    const slug = trigger.dataset.gloss || '';
    const d = data[slug];
    if (!d) return;
    openSlug = slug;
    openTrigger = trigger;
    (document.getElementById('gloss-card-term') as HTMLElement).textContent = d.term;
    (document.getElementById('gloss-card-cat') as HTMLElement).textContent = d.category || 'Glossary';
    (document.getElementById('gloss-card-short') as HTMLElement).textContent = d.short;
    (document.getElementById('gloss-card-more') as HTMLAnchorElement).href = `${base}/glossary/${slug}`;
    setStatus(slug, 'seen', true);
    card.classList.remove('hidden');
    position(trigger);
    paintButtons();
    paintTerms();
  }

  function close() {
    card.classList.add('hidden');
    openSlug = null;
    openTrigger?.focus({ preventScroll: true });
    openTrigger = null;
  }

  document.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const term = el.closest<HTMLElement>('.gloss-term');
    if (term) {
      e.preventDefault();
      if (openSlug === term.dataset.gloss && !card.classList.contains('hidden')) close();
      else open(term);
      return;
    }
    if (el.closest('.gloss-close')) { close(); return; }
    const statusBtn = el.closest<HTMLElement>('.gloss-status');
    if (statusBtn && openSlug) {
      const wanted = statusBtn.dataset.status as Rec['status'];
      const current = load()[openSlug]?.status;
      setStatus(openSlug, current === wanted ? 'seen' : wanted);
      paintButtons();
      paintTerms();
      return;
    }
    if (!card.classList.contains('hidden') && !el.closest('#gloss-card')) close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !card.classList.contains('hidden')) close();
  });
  window.addEventListener('resize', () => { if (openTrigger && !card.classList.contains('hidden')) position(openTrigger); });
  window.addEventListener('bible:terms-updated', paintTerms);

  paintTerms();
</script>
