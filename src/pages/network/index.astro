---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Concept Network">
  <div class="max-w-7xl mx-auto">
    <a href={base} class="text-sm text-slate-500 hover:text-amber-600">&larr; Back to Home</a>

    <header class="mt-6 mb-8">
      <div class="text-5xl mb-3">🕸️</div>
      <h1 class="text-4xl font-bold tracking-tight">Concept Network</h1>
      <p class="text-slate-600 mt-2 max-w-2xl">
        Every concept in the B.I.B.L.E., connected to the concepts it relates to. Tap a circle to see what it connects to; tap it again to open that concept. On a computer, hover to highlight and click to open.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Sidebar -->
      <aside class="lg:col-span-1 order-2 lg:order-1">
        <div class="p-5 bg-slate-50 border border-slate-200 rounded-lg sticky top-24">
          <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-3">
            Legend
          </div>

          <div class="space-y-2 mb-5">
            <div class="flex items-center gap-2 text-sm">
              <span class="inline-block w-3 h-3 rounded-full" style="background: #2563eb;"></span>
              <span class="text-slate-700">Foundational</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <span class="inline-block w-3 h-3 rounded-full" style="background: #16a34a;"></span>
              <span class="text-slate-700">Goal Tracks</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <span class="inline-block w-3 h-3 rounded-full" style="background: #dc2626;"></span>
              <span class="text-slate-700">Conditioning</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <span class="inline-block w-3 h-3 rounded-full" style="background: #1e293b;"></span>
              <span class="text-slate-700">Sport-Specific</span>
            </div>
          </div>

          <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-2">
            Stats
          </div>
          <div id="network-stats" class="text-sm text-slate-700 mb-3">
            Loading...
          </div>

          <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-2">
            Your Mastery
          </div>
          <div id="network-mastery" class="text-sm text-slate-700 mb-3">
            Loading...
          </div>

          <div id="network-progress-bar" class="w-full h-2 bg-slate-200 rounded-full mb-5 overflow-hidden">
            <div id="network-progress-fill" class="h-full bg-gradient-to-r from-blue-500 to-green-500 transition-all duration-500" style="width: 0%;"></div>
          </div>

          <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-2">
            By Category
          </div>
          <div id="network-categories" class="text-xs text-slate-700 mb-5 space-y-1">
            Loading...
          </div>

          <div class="text-xs uppercase tracking-wider text-slate-500 font-semibold mb-2">
            Selected
          </div>
          <div id="network-hover" class="text-sm text-slate-600 italic">
            Nothing selected
          </div>
        </div>
      </aside>

      <!-- Graph canvas -->
      <div class="lg:col-span-3 order-1 lg:order-2">
        <div
          id="network-container"
          class="bg-white border border-slate-200 rounded-lg overflow-hidden"
          style="height: min(720px, 75vh); position: relative;"
        >
          <div id="network-loading" class="absolute inset-0 flex items-center justify-center text-slate-400 text-sm">
            Loading network...
          </div>
          <svg id="network-svg" style="width: 100%; height: 100%; display: block;"></svg>
        </div>

        <div id="network-tap-info" class="lg:hidden mt-3 p-3 bg-white border border-slate-200 rounded-lg text-sm text-slate-600 italic">
          Tap a circle to see its connections.
        </div>
        <p class="text-xs text-slate-500 mt-3">
          Node size and color will grow with your mastery in future updates.
          Mastered concepts will light up their connections to other concepts.
        </p>
      </div>
    </div>
  </div>

  <!-- D3 from CDN -->
  <script src="https://cdn.jsdelivr.net/npm/d3@7"></script>

  <!-- Graph script -->
  <script>
    (async function () {
      const svg = document.getElementById('network-svg');
      const container = document.getElementById('network-container');
      let lastTapped = null;
      const loading = document.getElementById('network-loading');
      const statsEl = document.getElementById('network-stats');
      const hoverEl = window.matchMedia('(max-width: 1023px)').matches
        ? document.getElementById('network-tap-info')
        : document.getElementById('network-hover');

      if (!svg || !container) return;

      // Wait for D3 to be available
      let tries = 0;
      while (typeof d3 === 'undefined' && tries < 50) {
        await new Promise((r) => setTimeout(r, 100));
        tries++;
      }
      if (typeof d3 === 'undefined') {
        loading.textContent = 'Failed to load D3.';
        return;
      }

      // Fetch graph data
      const base = document.body.dataset.base || '';
      const basePath = (window.location.pathname.split('/network')[0]) || '';
      let graphData;
      try {
        const res = await fetch(basePath + '/network/graph.json');
        graphData = await res.json();
      } catch (err) {
        loading.textContent = 'Failed to load graph data.';
        console.error(err);
        return;
      }

      const { nodes, edges } = graphData;

      const CATEGORY_COLORS = {
        foundational: '#2563eb', // blue
        goal: '#16a34a',         // green
        conditioning: '#dc2626', // red
        sport: '#1e293b',        // slate-800 (dark)
      };

      // Read mastery from localStorage (written by CFU component)
      function getMastery() {
        try {
          const raw = localStorage.getItem('bible:mastery');
          return raw ? JSON.parse(raw) : {};
        } catch (e) {
          return {};
        }
      }

      const mastery = getMastery();

      // Attach mastery level to each node
      nodes.forEach((n) => {
        n.mastery = mastery[n.id] || 0;
      });

      // Mastery summary calculations
      const totalConcepts = nodes.length;
      const masteredAny = nodes.filter((n) => n.mastery >= 1).length;
      const masteredAll = nodes.filter((n) => n.mastery >= 4).length;
      const percentMastered = Math.round((masteredAny / totalConcepts) * 100);

      // Dimensions
      const width = container.clientWidth;
      const height = container.clientHeight;

      const narrow = width < 600;
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');

      // Clear loading
      loading.style.display = 'none';

      // Create groups
      const root = d3.select(svg);
      const linkGroup = root.append('g').attr('class', 'links');
      const pulseGroup = root.append('g').attr('class', 'pulses');
      const nodeGroup = root.append('g').attr('class', 'nodes');
      const labelGroup = root.append('g').attr('class', 'labels');

      // Clone edges so d3 can mutate them
      const links = edges.map((e) => ({ source: e.source, target: e.target }));

      // Force simulation
      const simulation = d3
        .forceSimulation(nodes)
        .force(
          'link',
          d3
            .forceLink(links)
            .id((d) => d.id)
            .distance(narrow ? 95 : 120)
            .strength(0.6)
        )
        .force('charge', d3.forceManyBody().strength(narrow ? -320 : -400))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('collision', d3.forceCollide().radius(narrow ? 26 : 38))
        .force('x', d3.forceX(width / 2).strength(narrow ? 0.04 : 0.02))
        .force('y', d3.forceY(height / 2).strength(narrow ? 0.02 : 0.02));

      // Draw links — mastery-driven styling
      const link = linkGroup
        .selectAll('line')
        .data(links)
        .enter()
        .append('line')
        .attr('stroke', (d) => edgeStroke(d.source, d.target))
        .attr('stroke-width', (d) => edgeWidth(d.source, d.target))
        .attr('stroke-opacity', (d) => edgeOpacity(d.source, d.target))
        .style('transition', 'stroke 400ms ease, stroke-opacity 400ms ease, stroke-width 400ms ease');

      // Mastery-based radius and opacity
      function radiusForMastery(level) {
        // 0 → 14, 1 → 18, 2 → 22, 3 → 26, 4 → 30
        return 14 + (level * 4);
      }

      function opacityForMastery(level) {
        // 0 → 0.3 (dim), 1+ → 1 (full)
        return level === 0 ? 0.3 : 1;
      }

      // Edge opacity based on mastery of both endpoints
      function edgeOpacity(source, target) {
        const sMastered = (source.mastery || 0) >= 1;
        const tMastered = (target.mastery || 0) >= 1;
        if (sMastered && tMastered) return 1.0;   // both mastered
        if (sMastered || tMastered) return 0.4;   // one mastered
        return 0.1;                                // neither
      }

      function edgeStroke(source, target) {
        const sMastered = (source.mastery || 0) >= 1;
        const tMastered = (target.mastery || 0) >= 1;
        if (sMastered && tMastered) {
          // Use category color of the source node
          return CATEGORY_COLORS[source.category] || '#64748b';
        }
        return '#cbd5e1'; // slate-300 for un-mastered edges
      }

      function edgeWidth(source, target) {
        const sMastered = (source.mastery || 0) >= 1;
        const tMastered = (target.mastery || 0) >= 1;
        if (sMastered && tMastered) return 2.5;
        if (sMastered || tMastered) return 1.5;
        return 1.0;
      }

      // Pulse a node: expanding ring that fades out
      function pulseNode(nodeDatum) {
        const x = nodeDatum.x;
        const y = nodeDatum.y;
        if (x == null || y == null) return;

        const color = CATEGORY_COLORS[nodeDatum.category] || '#64748b';

        const ring = pulseGroup
          .append('circle')
          .attr('cx', x)
          .attr('cy', y)
          .attr('r', radiusForMastery(nodeDatum.mastery || 0))
          .attr('fill', 'none')
          .attr('stroke', color)
          .attr('stroke-width', 3)
          .attr('opacity', 1);

        ring
          .transition()
          .duration(1400)
          .ease(d3.easeCubicOut)
          .attr('r', radiusForMastery(nodeDatum.mastery || 0) + 45)
          .attr('stroke-width', 0.5)
          .attr('opacity', 0)
          .remove();
      }

      // Draw nodes
      const node = nodeGroup
        .selectAll('circle')
        .data(nodes)
        .enter()
        .append('circle')
        .attr('r', (d) => radiusForMastery(d.mastery || 0))
        .attr('fill', (d) => CATEGORY_COLORS[d.category] || '#94a3b8')
        .attr('stroke', '#ffffff')
        .attr('stroke-width', 2)
        .style('cursor', 'pointer')
        .style('opacity', (d) => opacityForMastery(d.mastery || 0))
        .style('transition', 'r 300ms ease, opacity 300ms ease')
        .on('mouseover', function (event, d) {
          // Highlight this node and its neighbors
          const connectedIds = new Set();
          connectedIds.add(d.id);
          links.forEach((l) => {
            if (l.source.id === d.id) connectedIds.add(l.target.id);
            if (l.target.id === d.id) connectedIds.add(l.source.id);
          });

          node.style('opacity', (n) => (connectedIds.has(n.id) ? 1 : 0.15));
          // (highlight overrides mastery dim while hovering)
          link.style('stroke-opacity', (l) =>
            l.source.id === d.id || l.target.id === d.id ? 0.9 : 0.05
          );
          link.style('stroke', (l) =>
            l.source.id === d.id || l.target.id === d.id ? CATEGORY_COLORS[d.category] || '#64748b' : '#cbd5e1'
          );
          label.style('opacity', (n) => (connectedIds.has(n.id) ? 1 : 0.15));

          const connectedTitles = nodes
            .filter((n) => connectedIds.has(n.id) && n.id !== d.id)
            .map((n) => n.title);

          const level = d.mastery || 0;
          const levelLabel =
            level === 0
              ? '<span class="text-slate-500 italic">Not yet started</span>'
              : '<span class="text-slate-700">Level ' +
                level +
                ' of 4' +
                (level === 4 ? ' — full mastery' : '') +
                '</span>';

          hoverEl.innerHTML =
            '<strong class="text-slate-800">' +
            d.title +
            '</strong><br>' +
            levelLabel +
            '<br><span class="text-xs">Connected to ' +
            connectedTitles.length +
            ' concept' +
            (connectedTitles.length === 1 ? '' : 's') +
            '</span>';
        })
        .on('mouseout', function () {
          node.style('opacity', (n) => opacityForMastery(n.mastery || 0));
          link
            .style('stroke-opacity', (l) => edgeOpacity(l.source, l.target))
            .style('stroke', (l) => edgeStroke(l.source, l.target))
            .style('stroke-width', (l) => edgeWidth(l.source, l.target));
          label.style('opacity', (n) => opacityForMastery(n.mastery || 0));
          hoverEl.textContent = 'Nothing selected';
        })
        .on('click', function (event, d) {
          // On touch screens there is no hover: first tap highlights, second tap opens.
          const touch = window.matchMedia('(hover: none)').matches;
          if (touch && lastTapped !== d.id) {
            lastTapped = d.id;
            d3.select(this).dispatch('mouseover');
            hoverEl.insertAdjacentHTML('beforeend', '<br><span class="text-xs text-amber-700 font-semibold">Tap again to open</span>');
            return;
          }
          window.location.href = basePath + '/concepts/' + d.id + '/';
        })
        .call(
          d3
            .drag()
            .on('start', dragstarted)
            .on('drag', dragged)
            .on('end', dragended)
        );

      // Draw labels
      const label = labelGroup
        .selectAll('text')
        .data(nodes)
        .enter()
        .append('text')
        .text((d) => d.icon)
        .attr('text-anchor', 'middle')
        .attr('dy', '0.35em')
        .attr('font-size', 16)
        .style('opacity', (d) => opacityForMastery(d.mastery || 0))
        .style('pointer-events', 'none')
        .style('user-select', 'none')
        .style('transition', 'opacity 300ms ease');

      // Sim tick
      // Keep every circle inside the box (small phone screens especially).
      const PAD = 24;
      simulation.on('tick', () => {
        nodes.forEach((d) => {
          d.x = Math.max(PAD, Math.min(width - PAD, d.x));
          d.y = Math.max(PAD, Math.min(height - PAD, d.y));
        });
        link
          .attr('x1', (d) => d.source.x)
          .attr('y1', (d) => d.source.y)
          .attr('x2', (d) => d.target.x)
          .attr('y2', (d) => d.target.y);

        node.attr('cx', (d) => d.x).attr('cy', (d) => d.y);
        label.attr('x', (d) => d.x).attr('y', (d) => d.y);
      });

      // Drag handlers
      function dragstarted(event, d) {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x;
        d.fy = d.y;
      }
      function dragged(event, d) {
        d.fx = event.x;
        d.fy = event.y;
      }
      function dragended(event, d) {
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null;
        d.fy = null;
      }

      // Stats
      const categoryCounts = {};
      nodes.forEach((n) => {
        categoryCounts[n.category] = (categoryCounts[n.category] || 0) + 1;
      });
      statsEl.innerHTML =
        '<div>' +
        nodes.length +
        ' concepts</div><div>' +
        edges.length +
        ' connections</div>';

      // Subtle entrance pulse for any already-mastered nodes
      setTimeout(() => {
        nodes.forEach((n) => {
          if ((n.mastery || 0) >= 1) pulseNode(n);
        });
      }, 800);

      // Mastery summary + progress bar + category breakdown
      const masteryEl = document.getElementById('network-mastery');
      const progressFill = document.getElementById('network-progress-fill');
      const categoriesEl = document.getElementById('network-categories');

      const CATEGORY_LABELS = {
        foundational: 'Foundational',
        goal: 'Goal Tracks',
        conditioning: 'Conditioning',
        sport: 'Sport-Specific',
      };

      const CATEGORY_HEX = {
        foundational: '#2563eb',
        goal: '#16a34a',
        conditioning: '#dc2626',
        sport: '#1e293b',
      };

      function updateMasteryDisplay() {
        const anyCount = nodes.filter((n) => (n.mastery || 0) >= 1).length;
        const allCount = nodes.filter((n) => (n.mastery || 0) >= 4).length;
        const pct = Math.round((anyCount / totalConcepts) * 100);

        if (masteryEl) {
          if (anyCount === 0) {
            masteryEl.innerHTML =
              '<div class="text-slate-500 italic">No concepts mastered yet</div>' +
              '<div class="text-xs text-slate-500 mt-1">Pass a CFU on any concept to start lighting up the network.</div>';
          } else {
            masteryEl.innerHTML =
              '<div class="text-slate-800 font-medium">' +
              anyCount + ' of ' + totalConcepts + ' concepts started</div>' +
              '<div class="text-xs text-slate-600 mt-1">' +
              pct + '% of the network touched</div>' +
              '<div class="text-xs text-slate-600 mt-1">' +
              allCount + ' at full mastery (Level 4)</div>';
          }
        }

        if (progressFill) {
          progressFill.style.width = pct + '%';
        }

        if (categoriesEl) {
          const groups = {};
          nodes.forEach((n) => {
            const cat = n.category || 'foundational';
            if (!groups[cat]) groups[cat] = { total: 0, mastered: 0 };
            groups[cat].total += 1;
            if ((n.mastery || 0) >= 1) groups[cat].mastered += 1;
          });

          let html = '';
          ['foundational', 'goal', 'conditioning', 'sport'].forEach((cat) => {
            if (!groups[cat]) return;
            const g = groups[cat];
            html +=
              '<div class="flex items-center gap-2">' +
              '<span class="inline-block w-2 h-2 rounded-full" style="background:' +
              CATEGORY_HEX[cat] +
              ';"></span>' +
              '<span class="flex-1">' +
              CATEGORY_LABELS[cat] +
              '</span>' +
              '<span class="text-slate-500">' +
              g.mastered +
              '/' +
              g.total +
              '</span>' +
              '</div>';
          });
          categoriesEl.innerHTML = html;
        }
      }

      updateMasteryDisplay();

      // Listen for live mastery updates from the CFU component
      window.addEventListener('bible:mastery-updated', function (event) {
        // Snapshot prior mastery levels
        const priorMastery = {};
        nodes.forEach((n) => {
          priorMastery[n.id] = n.mastery || 0;
        });

        const newMastery = getMastery();
        nodes.forEach((n) => {
          n.mastery = newMastery[n.id] || 0;
        });

        // Pulse any node whose mastery level increased
        nodes.forEach((n) => {
          if ((n.mastery || 0) > (priorMastery[n.id] || 0)) {
            pulseNode(n);
          }
        });

        // Live resize + re-dim
        node
          .transition()
          .duration(400)
          .attr('r', (d) => radiusForMastery(d.mastery || 0))
          .style('opacity', (d) => opacityForMastery(d.mastery || 0));

        label
          .transition()
          .duration(400)
          .style('opacity', (d) => opacityForMastery(d.mastery || 0));

        // Live edge reveal — fade and recolor edges based on new mastery
        link
          .transition()
          .duration(400)
          .style('stroke-opacity', (l) => edgeOpacity(l.source, l.target))
          .style('stroke', (l) => edgeStroke(l.source, l.target))
          .style('stroke-width', (l) => edgeWidth(l.source, l.target));

        // Refresh sidebar
        updateMasteryDisplay();
      });

      // Keyboard escape to reset view
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          node.style('opacity', (n) => opacityForMastery(n.mastery || 0));
          link
            .style('stroke-opacity', (l) => edgeOpacity(l.source, l.target))
            .style('stroke', (l) => edgeStroke(l.source, l.target))
            .style('stroke-width', (l) => edgeWidth(l.source, l.target));
          label.style('opacity', (n) => opacityForMastery(n.mastery || 0));
          hoverEl.textContent = 'Nothing selected';
        }
      });

      // Handle resize
      window.addEventListener('resize', () => {
        const newWidth = container.clientWidth;
        const newHeight = container.clientHeight;
        svg.setAttribute('viewBox', `0 0 ${newWidth} ${newHeight}`);
        simulation.force('center', d3.forceCenter(newWidth / 2, newHeight / 2));
        simulation.alpha(0.3).restart();
      });
    })();
  </script>
</BaseLayout>
