---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('programs');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const typeLabel = (item.data.type ?? 'program').replace(/[-_]+/g, ' ').replace(/^./, (c) => c.toUpperCase());
---

<BaseLayout title={item.data.title}>
  <article class="max-w-3xl">
    <a href={`${base}/programs`} class="text-sm text-slate-500 hover:text-amber-600">&larr; Back to Programs</a>
    <header class="mt-6 mb-10">
      <div class="text-5xl mb-3">{item.data.icon}</div>
      <h1 class="text-4xl font-bold tracking-tight">{item.data.title}</h1>
      <p class="text-slate-500 mt-2">{typeLabel}</p>
    </header>
    {item.data.prerequisites && item.data.prerequisites.length > 0 && (
      <section class="mb-10 p-5 bg-amber-50 border border-amber-200 rounded-lg">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-amber-700 mb-3">Prerequisites</h2>
        <ul class="text-sm text-slate-700 space-y-1">
          {item.data.prerequisites.map(p => <li>&bull; {p}</li>)}
        </ul>
      </section>
    )}
    <div class="md-body text-slate-700 leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
