---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('programs')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Programs">
  <h1 class="text-4xl font-bold mb-4">Training Programs</h1>
  <p class="text-slate-600 mb-10 max-w-2xl">
    Nine programs ranging from foundational full-body strength to specialization cycles.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {items.map(item => (
      <a href={`${base}/programs/${item.slug}`} class="block p-5 bg-white rounded-lg border border-slate-200 hover:border-amber-400 hover:shadow-md transition">
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">{item.data.icon}</span>
          <h3 class="text-lg font-semibold">{item.data.title}</h3>
        </div>
        <p class="text-sm text-slate-500">{(item.data.type ?? 'program').replace(/[-_]+/g, ' ').replace(/^./, (c) => c.toUpperCase())}</p>
      </a>
    ))}
  </div>
</BaseLayout>
