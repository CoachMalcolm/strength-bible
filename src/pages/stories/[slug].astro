---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('stories');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await item.render();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={item.data.title}>
  <article class="max-w-3xl">
    <a href={`${base}/stories`} class="text-sm text-slate-500 hover:text-amber-600">&larr; Back to Stories</a>
    <header class="mt-6 mb-10">
      <div class="text-5xl mb-3">{item.data.icon}</div>
      <h1 class="text-4xl font-bold tracking-tight">{item.data.title}</h1>
    </header>
    <div class="md-body text-slate-700 leading-relaxed">
      <Content />
    </div>
  </article>
</BaseLayout>
<script>
  const PREFIX = 'bible:';
  const storyId = window.location.pathname.split('/').filter(Boolean).pop() || '';
  if (storyId) {
    try {
      const raw = localStorage.getItem(PREFIX + 'stories');
      const stories = raw ? JSON.parse(raw) : [];
      if (!stories.find((s) => s.id === storyId)) {
        stories.push({ id: storyId, date: new Date().toISOString() });
        localStorage.setItem(PREFIX + 'stories', JSON.stringify(stories));
      }
    } catch {}
  }
</script>
