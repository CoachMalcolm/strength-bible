---
import ContentDetail from '../../layouts/ContentDetail.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('bodyweight');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<ContentDetail title={item.data.title} icon={item.data.icon} category="Bodyweight" levels={item.data.levels ?? []} sources={item.data.sources} backHref={`${base}/bodyweight`} backLabel="Back to Bodyweight" slug={item.slug} />
