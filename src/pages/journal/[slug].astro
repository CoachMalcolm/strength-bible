---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalEntryForm from '../../components/JournalEntryForm.astro';
import ReflectionPanel from '../../components/ReflectionPanel.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('journal');
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isTemplate = item.data.type === 'program-log' || item.data.type === 'template';
---

<BaseLayout title={item.data.title}>
  <article class="max-w-3xl">
    <a href={`${base}/journal`} class="text-sm text-slate-500 hover:text-amber-600">&larr; Back to Journal</a>
    <header class="mt-6 mb-10">
      <div class="text-5xl mb-3">{item.data.icon}</div>
      <h1 class="text-4xl font-bold tracking-tight">{item.data.title}</h1>
    </header>
    <div class="md-body text-slate-700 leading-relaxed">
      <Content />
    </div>
  </article>

  {isTemplate && (
    <div class="max-w-3xl">
      <ReflectionPanel templateSlug={item.slug} />
    </div>
  )}

  {isTemplate && (
    <section class="mt-12 max-w-3xl border-t border-slate-200 pt-10">
      <h2 class="text-2xl font-bold mb-6">Start a New Entry</h2>
      <JournalEntryForm templateSlug={item.slug} />
    </section>
  )}
</BaseLayout>
