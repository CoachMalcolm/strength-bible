---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const concepts = (await getCollection('concepts')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const lifts = (await getCollection('lifts')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const bodyweight = (await getCollection('bodyweight')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const mobility = (await getCollection('mobility')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const programs = (await getCollection('programs')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const sections = [
  { title: 'Concepts', items: concepts, path: 'concepts' },
  { title: 'Lifts', items: lifts, path: 'lifts' },
  { title: 'Bodyweight', items: bodyweight, path: 'bodyweight' },
  { title: 'Mobility', items: mobility, path: 'mobility' },
];
---
<BaseLayout title="Mastery Tracker">
  <h1 class="text-4xl font-bold mb-4">Mastery Tracker</h1>
  <p class="text-slate-600 mb-6 max-w-2xl">
    Your progress across every concept and movement. Levels unlock as you pass each Check for Understanding.
  </p>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-10">
    <div class="p-4 bg-white border border-slate-200 rounded-lg">
      <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">Concepts Mastered</div>
      <div class="text-2xl font-bold" id="stat-concepts">0</div>
    </div>
    <div class="p-4 bg-white border border-slate-200 rounded-lg">
      <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">Journal Entries</div>
      <div class="text-2xl font-bold" id="stat-entries">0</div>
    </div>
    <div class="p-4 bg-white border border-slate-200 rounded-lg">
      <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">Stories Opened</div>
      <div class="text-2xl font-bold" id="stat-stories">0</div>
    </div>
    <div class="p-4 bg-white border border-slate-200 rounded-lg">
      <div class="text-xs uppercase tracking-wider text-slate-500 mb-1">Current Streak</div>
      <div class="text-2xl font-bold" id="stat-streak">0</div>
    </div>
  </div>

  <div id="mastery-root">
    {sections.map(section => (
      <section class="mb-10">
        <h2 class="text-2xl font-semibold mb-4 pb-2 border-b border-slate-200">{section.title}</h2>
        <div class="space-y-3">
          {section.items.map(item => (
            <div class="mastery-row flex items-center justify-between p-4 bg-white border border-slate-200 rounded-lg" data-slug={item.slug}>
              <a href={`${base}/${section.path}/${item.slug}`} class="flex items-center gap-3 hover:text-amber-600 transition">
                <span class="text-2xl">{item.data.icon}</span>
                <span class="font-medium">{item.data.title}</span>
              </a>
              <div class="flex gap-1">
                {[1,2,3,4].map(lvl => (
                  <span class="mastery-dot w-6 h-6 rounded-full border-2 border-slate-300 flex items-center justify-center text-xs text-slate-400" data-level={lvl}>{lvl}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="mb-10">
      <h2 class="text-2xl font-semibold mb-4 pb-2 border-b border-slate-200">Programs</h2>
      <div class="space-y-3">
        {programs.map(item => (
          <div class="flex items-center justify-between p-4 bg-white border border-slate-200 rounded-lg">
            <a href={`${base}/programs/${item.slug}`} class="flex items-center gap-3 hover:text-amber-600 transition">
              <span class="text-2xl">{item.data.icon}</span>
              <span class="font-medium">{item.data.title}</span>
            </a>
            <span class="program-status text-xs text-slate-400" data-program={item.slug}>Not started</span>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section class="mt-16 pt-8 border-t border-slate-200">
    <h2 class="text-2xl font-semibold mb-4">Your Data</h2>
    <p class="text-sm text-slate-600 mb-4 max-w-2xl">
      All your data is stored locally in this browser. Nothing leaves your device.
      Export a JSON backup to move data to another device.
    </p>
    <div class="flex flex-wrap gap-3">
      <button id="export-btn" class="px-4 py-2 bg-slate-900 text-white rounded-md text-sm hover:bg-slate-700 transition">Export Backup</button>
      <label class="px-4 py-2 bg-slate-100 text-slate-800 rounded-md text-sm hover:bg-slate-200 transition cursor-pointer">
        Import Backup
        <input type="file" id="import-input" class="hidden" accept=".json" />
      </label>
      <button id="clear-btn" class="px-4 py-2 bg-red-100 text-red-700 rounded-md text-sm hover:bg-red-200 transition">Clear All Data</button>
    </div>
    <div id="backup-status" class="mt-4 text-sm"></div>
  </section>
</BaseLayout>

<script>
  const PREFIX = 'bible:';

  function readMastery() {
    try {
      const raw = localStorage.getItem(PREFIX + 'mastery');
      return raw ? JSON.parse(raw) : {};
    } catch { return {}; }
  }
  function readStories() {
    try {
      const raw = localStorage.getItem(PREFIX + 'stories');
      return raw ? JSON.parse(raw) : [];
    } catch { return []; }
  }
  function readJournal() {
    try {
      const raw = localStorage.getItem(PREFIX + 'journal');
      return raw ? JSON.parse(raw) : [];
    } catch { return []; }
  }

  function computeStreak(entries: any[]): number {
    if (entries.length === 0) return 0;
    const dates = Array.from(new Set(entries.map(e => e.date))).sort().reverse();
    const today = new Date(); today.setHours(0,0,0,0);
    let streak = 0;
    let cursor = new Date(today);
    for (const d of dates) {
      const entryDate = new Date(d);
      entryDate.setHours(0,0,0,0);
      const diff = Math.round((cursor.getTime() - entryDate.getTime()) / 86400000);
      if (diff === 0 || diff === 1) {
        streak++;
        cursor = entryDate;
      } else break;
    }
    return streak;
  }

  function paint() {
    const mastery = readMastery();
    const stories = readStories();
    const journal = readJournal();

    document.querySelectorAll('.mastery-row').forEach((row) => {
      const slug = (row as HTMLElement).dataset.slug || '';
      const level = mastery[slug] ?? 0;
      row.querySelectorAll('.mastery-dot').forEach((dot) => {
        const dotLevel = parseInt((dot as HTMLElement).dataset.level || '0', 10);
        dot.classList.remove('bg-green-500', 'border-green-500', 'text-white', 'bg-slate-100', 'text-slate-400', 'border-slate-300');
        if (dotLevel <= level) {
          dot.classList.add('bg-green-500', 'border-green-500', 'text-white');
        } else {
          dot.classList.add('bg-slate-100', 'text-slate-400', 'border-slate-300');
        }
      });
    });

    // Program status
    document.querySelectorAll('.program-status').forEach((el) => {
      const program = (el as HTMLElement).dataset.program || '';
      const entries = journal.filter((e: any) => e.templateSlug === `training-log-${program}` || e.templateSlug === `training-log-${program.replace('-', '')}`);
      const count = entries.length;
      if (count > 0) {
        el.textContent = `${count} entr${count === 1 ? 'y' : 'ies'}`;
        el.className = 'program-status text-xs text-green-600 font-medium';
      } else {
        el.textContent = 'Not started';
        el.className = 'program-status text-xs text-slate-400';
      }
    });

    // Stats
    const conceptsMastered = Object.entries(mastery).filter(([_, lvl]) => (lvl as number) >= 1).length;
    document.getElementById('stat-concepts')!.textContent = String(conceptsMastered);
    document.getElementById('stat-entries')!.textContent = String(journal.length);
    document.getElementById('stat-stories')!.textContent = String(stories.length);
    document.getElementById('stat-streak')!.textContent = String(computeStreak(journal));
  }

  paint();

  const status = document.getElementById('backup-status') as HTMLElement;

  document.getElementById('export-btn')?.addEventListener('click', () => {
    const data = {
      version: 1,
      exportedAt: new Date().toISOString(),
      mastery: readMastery(),
      stories: readStories(),
      journal: readJournal(),
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `strength-bible-backup-${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
    if (status) status.textContent = '✓ Backup exported.';
  });

  document.getElementById('import-input')?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(reader.result as string);
        if (data.mastery) localStorage.setItem(PREFIX + 'mastery', JSON.stringify(data.mastery));
        if (data.stories) localStorage.setItem(PREFIX + 'stories', JSON.stringify(data.stories));
        if (data.journal) localStorage.setItem(PREFIX + 'journal', JSON.stringify(data.journal));
        if (status) status.textContent = '✓ Backup imported. Refresh to see changes.';
        paint();
      } catch {
        if (status) status.textContent = '✗ Import failed. Invalid file.';
      }
    };
    reader.readAsText(file);
  });

  document.getElementById('clear-btn')?.addEventListener('click', () => {
    if (!confirm('This will delete all your journal data. Continue?')) return;
    ['mastery', 'stories', 'journal'].forEach(k => localStorage.removeItem(PREFIX + k));
    if (status) status.textContent = '✓ All data cleared.';
    paint();
  });
</script>
